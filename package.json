{
  "name": "opencode-auto-translate",
  "version": "0.2.1",
  "description": "Translate user prompts to English before OpenCode sends them to the main model.",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "translation",
    "localization",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dogalyir/opencode-auto-translate.git"
  },
  "bugs": {
    "url": "https://github.com/dogalyir/opencode-auto-translate/issues"
  },
  "homepage": "https://github.com/dogalyir/opencode-auto-translate#readme",
  "module": "./dist/server.js",
  "main": "./dist/server.js",
  "bin": {
    "opencode-auto-translate": "./dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=1.18.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "generate:schema": "bun scripts/generate-schema.ts",
    "build": "bun run generate:schema && bun build src/server.ts src/tui.tsx src/cli.ts --outdir dist --target node --external '@opentui/*' --external 'solid-js'",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "bunx oxlint src test",
    "check:duplicates": "bunx jscpd src test --threshold 0",
    "check:unused": "bunx knip",
    "check:fallow": "fallow --production --ci --skip health",
    "analyze:fallow": "fallow --production --skip dead-code,dupes; exit 0",
    "check:all": "bun run typecheck && bun test && bun run lint && bun run check:duplicates && bun run check:unused && bun run check:fallow && bun run build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.5",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/bun": "latest",
    "fallow": "^3.9.1",
    "jscpd": "^5.0.12",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.75.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "solid-js": "1.9.12"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.5",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "1.9.12"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "bunx oxlint"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "bun run check:all"
  }
}
